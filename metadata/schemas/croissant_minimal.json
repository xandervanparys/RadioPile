{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RadioPile minimal Croissant conformance schema",
  "description": "The parts of an MLCommons Croissant 1.0 descriptor that every artifact emitted by metadata/croissant.py must have. This is deliberately a floor, not the full Croissant specification: it pins the fields that downstream consumers and the release bundler depend on, so a regression in the emitter fails a test instead of shipping. Full conformance is checked with `mlcroissant validate`.",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "conformsTo",
    "name",
    "description",
    "dateCreated",
    "license",
    "citation",
    "distribution",
    "recordSet",
    "radiopile:task",
    "radiopile:labels",
    "radiopile:preprocessing"
  ],
  "properties": {
    "@context": {
      "type": "object",
      "required": [
        "cr",
        "sc",
        "radiopile"
      ]
    },
    "@type": {
      "const": "sc:Dataset"
    },
    "conformsTo": {
      "const": "http://mlcommons.org/croissant/1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "dateCreated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datePublished": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "@type",
          "@id",
          "name",
          "contentUrl",
          "encodingFormat",
          "sha256"
        ],
        "properties": {
          "@type": {
            "const": "cr:FileObject"
          },
          "@id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contentUrl": {
            "type": "string",
            "minLength": 1
          },
          "encodingFormat": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "recordSet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "@type",
          "@id",
          "name",
          "field"
        ],
        "properties": {
          "@type": {
            "const": "cr:RecordSet"
          },
          "@id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "@type",
                "@id",
                "name",
                "dataType",
                "source"
              ],
              "properties": {
                "@type": {
                  "const": "cr:Field"
                },
                "@id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "dataType": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "object",
                  "required": [
                    "fileObject",
                    "extract"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "radiopile:task": {
      "type": "object",
      "required": [
        "type",
        "input",
        "target",
        "labelCount"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "labelCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "radiopile:labels": {
      "type": "object"
    },
    "radiopile:preprocessing": {
      "type": "object"
    },
    "radiopile:provenance": {
      "type": "object"
    },
    "radiopile:relatedIdentifiers": {
      "type": "string"
    }
  }
}
